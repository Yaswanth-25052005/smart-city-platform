# =============================================================================
# Smart City Platform — Environment Configuration
# Copy to .env and adjust values. Never commit .env to version control.
# =============================================================================

# --- MongoDB ---
MONGO_USER=admin
MONGO_PASSWORD=password
MONGO_DATABASE=smart_city

# Host access (running services outside Docker on Windows/macOS/Linux)
MONGO_URI=mongodb://admin:password@localhost:27017/

# Legacy key (kept for backward compatibility with existing code)
DATABASE_NAME=smart_city

# --- Kafka ---
# Host access
KAFKA_BOOTSTRAP=localhost:9092

# Container access (used by docker-compose service overrides)
KAFKA_BOOTSTRAP_INTERNAL=kafka:29092

KAFKA_SENSOR_TOPIC=smartcity.sensor_data
KAFKA_ALERT_TOPIC=smartcity.alerts
KAFKA_ANALYTICS_TOPIC=smartcity.analytics

# Legacy key (kept for backward compatibility)
TOPIC_NAME=smartcity.sensor_data

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_URL=http://localhost:8000

# --- Dashboard ---
DASHBOARD_PORT=8501

# --- Simulator ---
SIMULATOR_INTERVAL_SECONDS=3
SIMULATOR_DEVICE_COUNT=5

# --- Spark (Docker only — no host Java/PySpark required) ---
SPARK_MASTER=local[*]
SPARK_APP_NAME=smart-city-analytics

# --- Logging ---
LOG_LEVEL=INFO

# --- ML (Phase 7 — disabled in Phase 1) ---
ML_ENABLED=false

# --- Mongo Express (optional UI) ---
ME_CONFIG_BASICAUTH_USERNAME=admin
ME_CONFIG_BASICAUTH_PASSWORD=password
